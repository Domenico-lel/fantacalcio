# ── Clerk (autenticazione) ─────────────────────────────────────────────────────
# Ottieni le chiavi su: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/trofei
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Supabase (database) ────────────────────────────────────────────────────────
# Ottieni le chiavi su: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ── Fantacalcio lega (classifica) ──────────────────────────────────────────────
# Link completo della competizione: serve a identificare senza ambiguità la classifica.
# Es: https://leghe.fantacalcio.it/nome-della-lega/view/competition/123
FANTACALCIO_LEAGUE_URL=https://leghe.fantacalcio.it/nome-della-lega/view/competition/123
# Credenziali di un account Fantacalcio che può aprire la competizione. Devono
# essere impostate soltanto nelle variabili server del deploy (mai NEXT_PUBLIC_*).
FANTACALCIO_USERNAME=
FANTACALCIO_PASSWORD=

# ── Pronostici su partite reali (opzionale) ────────────────────────────────────
# football-data.org (gratuito): partite e risultati di Serie A, coppe, top campionati.
# Chiave: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# The Odds API (gratuito, 500 richieste/mese): pre-compila le quote 1/X/2.
# Chiave: https://the-odds-api.com/
ODDS_API_KEY=
