NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ── Fantacalcio lega (classifica) ──────────────────────────────────────────────
# Slug della tua lega su leghe.fantacalcio.it
# Es: https://leghe.fantacalcio.it/nome-della-lega → FANTACALCIO_LEAGUE_SLUG=nome-della-lega
FANTACALCIO_LEAGUE_SLUG=nome-della-lega

# ── Pronostici su partite reali (opzionale) ────────────────────────────────────
# football-data.org (gratuito): partite e risultati di Serie A, coppe, top campionati.
